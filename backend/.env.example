# ---- Required in production ----
NODE_ENV=production
PORT=8001
HOST=0.0.0.0
JWT_SECRET=                         # openssl rand -base64 48
PUBLIC_URL=https://your-service.onrender.com
ADMIN_PHONES=9XXXXXXXXX             # comma separated; these numbers become admins after OTP login

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rasik?retryWrites=true&w=majority

# ---- Cloudinary (Media storage for avatars, verification videos, voice intros) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMS OTP (India: MSG91 with a DLT-registered template) ----
SMS_PROVIDER=console                # console (dev only) | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # webhook URL: PUBLIC_URL/wallet/webhook  events: payment.captured, order.paid

# ---- WebRTC TURN (REQUIRED for reliable calls on Indian mobile networks) ----
TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turns:turn.yourdomain.com:5349?transport=tcp
TURN_SECRET=                        # coturn static-auth-secret

# ---- Economy (optional tuning) ----
WELCOME_COINS=12
LISTENER_PAISE_PER_COIN=45          # what a listener earns per coin spent
MIN_PAYOUT_PAISE=20000

# ---- Optional ----
CORS_ORIGINS=*
DATA_DIR=/tmp/data
REVIEW_PHONE=                       # fixed-OTP account for Play Store / App Store reviewers
REVIEW_OTP=

